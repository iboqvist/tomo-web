#!/bin/bash

set -e
export DEBIAN_FRONTEND=noninteractive

for _ in {1..10}; do
  apt-get update && apt-get upgrade -y && break
  sleep 5
done

apt-get install -y docker.io docker-compose-v2 cron

mkdir -p /opt/tomo

cat > /opt/tomo/compose.yaml <<'EOF'
${docker_compose_file}
EOF

cat > /opt/tomo/deploy.sh <<'EOF'
#!/bin/bash
set -euo pipefail
cd /opt/tomo
docker compose pull --quiet frontend backend
docker compose up -d --remove-orphans
docker image prune -f
EOF
chmod +x /opt/tomo/deploy.sh

/opt/tomo/deploy.sh || true

echo '*/2 * * * * root flock -n /opt/tomo/deploy.lock /opt/tomo/deploy.sh 2>&1 | logger -t tomo-deploy' > /etc/cron.d/tomo-deploy